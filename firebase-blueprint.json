{
  "entities": {
    "StoreSettings": {
      "title": "StoreSettings",
      "description": "Public storefront configuration, store story beats, hero 3D model URL, branch address, phone numbers, and external dashboard integration URL.",
      "type": "object",
      "properties": {
        "storeName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 140
        },
        "tagline": {
          "type": "string",
          "minLength": 2,
          "maxLength": 240
        },
        "aboutText": {
          "type": "string",
          "minLength": 5,
          "maxLength": 2000
        },
        "storyBeats": {
          "type": "array",
          "description": "Up to 4 editable store story beats displayed during the scroll-driven 3D hero."
        },
        "heroModelUrl": {
          "type": "string",
          "maxLength": 500
        },
        "address": {
          "type": "string",
          "minLength": 3,
          "maxLength": 300
        },
        "mapLink": {
          "type": "string",
          "maxLength": 400
        },
        "phones": {
          "type": "array",
          "description": "Up to 6 store phone numbers."
        },
        "whatsapp": {
          "type": "string",
          "maxLength": 30
        },
        "workingHours": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        },
        "externalAdminUrl": {
          "type": "string",
          "maxLength": 300
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "storeName",
        "tagline",
        "aboutText",
        "storyBeats",
        "address",
        "phones",
        "workingHours",
        "updatedAt"
      ]
    },
    "Product": {
      "title": "Product",
      "description": "Eyewear catalog item (optical, sunglasses, contact lenses, accessories) with color-isolated photo variants and optional pre-order availability.",
      "type": "object",
      "properties": {
        "slug": {
          "type": "string",
          "minLength": 2,
          "maxLength": 140,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 140
        },
        "category": {
          "type": "string",
          "enum": ["prescription", "sunglasses", "contact_lenses", "accessories"]
        },
        "price": {
          "type": "number"
        },
        "shortDesc": {
          "type": "string",
          "minLength": 2,
          "maxLength": 320
        },
        "fullDesc": {
          "type": "string",
          "minLength": 2,
          "maxLength": 2000
        },
        "frameShape": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "material": {
          "type": "string",
          "maxLength": 120
        },
        "dimensions": {
          "type": "string",
          "maxLength": 120
        },
        "published": {
          "type": "boolean"
        },
        "allowPreorder": {
          "type": "boolean"
        },
        "preorderNote": {
          "type": "string",
          "maxLength": 200
        },
        "variants": {
          "type": "array",
          "description": "Up to 15 color variants with separate image lists."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "slug",
        "name",
        "category",
        "price",
        "shortDesc",
        "fullDesc",
        "frameShape",
        "published",
        "allowPreorder",
        "variants",
        "updatedAt"
      ]
    },
    "OpticalLens": {
      "title": "OpticalLens",
      "description": "Prescription lens option with image, details list, refractive index, and pricing.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 140
        },
        "subtitle": {
          "type": "string",
          "minLength": 2,
          "maxLength": 240
        },
        "price": {
          "type": "number"
        },
        "imageUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 450000
        },
        "details": {
          "type": "array",
          "description": "Up to 10 feature bullet strings."
        },
        "fullDescription": {
          "type": "string",
          "minLength": 2,
          "maxLength": 1500
        },
        "refractiveIndex": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "published": {
          "type": "boolean"
        },
        "sortOrder": {
          "type": "number"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "name",
        "subtitle",
        "price",
        "imageUrl",
        "details",
        "fullDescription",
        "refractiveIndex",
        "published",
        "sortOrder",
        "updatedAt"
      ]
    },
    "Order": {
      "title": "Order",
      "description": "Customer Cash-on-Delivery order or pre-order with itemized frame+lens invoice breakdown and optional OD/OS/IPD/ADD or photo prescription.",
      "type": "object",
      "properties": {
        "orderCode": {
          "type": "string",
          "minLength": 4,
          "maxLength": 40,
          "pattern": "^[A-Z0-9\\-]+$"
        },
        "invoiceNumber": {
          "type": "string",
          "minLength": 4,
          "maxLength": 40
        },
        "orderType": {
          "type": "string",
          "enum": ["standard", "preorder"]
        },
        "userId": {
          "type": "string",
          "maxLength": 128
        },
        "customerName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "customerPhone": {
          "type": "string",
          "minLength": 7,
          "maxLength": 30
        },
        "customerAddress": {
          "type": "string",
          "minLength": 4,
          "maxLength": 400
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["cash_on_delivery"]
        },
        "notes": {
          "type": "string",
          "maxLength": 600
        },
        "items": {
          "type": "array",
          "description": "Up to 20 ordered line items."
        },
        "prescription": {
          "type": "object",
          "description": "OD/OS SPH, CYL, AXIS, ADD, IPD and/or uploaded prescription image URL."
        },
        "frameImageUrl": {
          "type": "string",
          "maxLength": 450000
        },
        "selectedFrameName": {
          "type": "string",
          "maxLength": 240
        },
        "selectedFrameColor": {
          "type": "string",
          "maxLength": 120
        },
        "prescriptionImageUrl": {
          "type": "string",
          "maxLength": 450000
        },
        "frameSubtotal": {
          "type": "number"
        },
        "lensSubtotal": {
          "type": "number"
        },
        "total": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "confirmed", "preparing", "ready", "delivered", "cancelled"]
        },
        "externalSyncStatus": {
          "type": "string",
          "enum": ["pending", "synced", "failed", "not_configured"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "orderCode",
        "invoiceNumber",
        "orderType",
        "customerName",
        "customerPhone",
        "customerAddress",
        "paymentMethod",
        "items",
        "frameSubtotal",
        "lensSubtotal",
        "total",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized store administrator record.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "role": {
          "type": "string",
          "enum": ["admin"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["email", "role", "createdAt"]
    }
  },
  "firestore": {
    "/store_settings/{settingId}": {
      "schema": { "$ref": "#/entities/StoreSettings" },
      "description": "Singleton storefront settings document ('main') readable by storefront visitors and editable only by admins."
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Eyewear catalog documents; published products are publicly readable while unpublished drafts and writes are admin-only."
    },
    "/lenses/{lensId}": {
      "schema": { "$ref": "#/entities/OpticalLens" },
      "description": "Optical lens catalog documents; published lenses are publicly readable while drafts and writes are admin-only."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer orders and pre-orders with PII and eye prescriptions; public create is strictly validated, while reads/updates/deletes are restricted to admins or matching signed-in owner."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Authorized admin UIDs managed exclusively by the primary store owner."
    }
  }
}
