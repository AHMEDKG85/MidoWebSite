# Server
NODE_ENV=production
PORT=3000
APP_URL=
DATABASE_PATH=./data/mido.sqlite
UPLOAD_DIR=./uploads

# Keep this stable across restarts; use at least 32 random characters.
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# Optional fixed admin token. Leave blank to set the first admin password at /admin.
ADMIN_TOKEN=

# Demo products are unpublished and are only inserted when explicitly enabled.
SEED_DEMO_CATALOG=false

# Optional outbound order webhook. The receiver must verify X-Mido-Signature
# (HMAC-SHA256 of the exact JSON request body) and deduplicate Idempotency-Key.
EXTERNAL_ADMIN_WEBHOOK_URL=
EXTERNAL_SYNC_SECRET=

